Algoritmo "LISTA 10"

Var
dia:inteiro

Inicio
escreva("Escreva um número entre 1 e 7 para descobrir o dia da semana: ")
leia(dia)

escolha dia
caso 1
escreval("domingo")
caso 2
escreval("segunda")
caso 3
escreval("terça")
caso 4
escreval("quarta")
caso 5
escreval("quinta")
caso 6
escreval("sexta")
caso 7
escreval("sábado")

outrocaso
escreval("Não Exite!")

fimescolha

Fimalgoritmo