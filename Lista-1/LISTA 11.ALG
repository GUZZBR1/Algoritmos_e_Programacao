Algoritmo "LISTA 11"

Var
mes:inteiro


Inicio
escreva("Escreva um número de 1 a 12 para descobrir o mês!: ")
leia (mes)

escolha mes
caso 1
escreval("janeiro")
caso 2
escreval("fevereira")
caso 3
escreval("março")
caso 4
escreval("abril")
caso 5
escreval("maio")
caso 6
escreval("junho")
caso 7
escreval("julho")
caso 8
escreval("agosto")
caso 9
escreval("setembro")
caso 10
escreval("outubro")
caso 11
escreval("novembro")
caso 12
escreval ("dezembro")

outrocaso
escreval("Não Existe Esse Mês!")
fimescolha


Fimalgoritmo